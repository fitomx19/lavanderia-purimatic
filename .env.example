# Copia este archivo como .env en la carpeta del ejecutable
# o usa el asistente del primer arranque (recomendado).
# Cada tienda debe tener SU propia URI de MongoDB Atlas.

FLASK_ENV=production

# Atlas > Connect > Drivers. Debe incluir el nombre de la base al final.
# Si la contraseña tiene @ : / # ? usa la versión URL-encoded.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/lavanderia_purimatic?retryWrites=true&w=majority
MONGODB_DB_NAME=lavanderia_purimatic

# En Atlas > Network Access permite la IP de esta tienda o 0.0.0.0/0

SECRET_KEY=cambia-esta-clave-flask
JWT_SECRET_KEY=cambia-esta-clave-jwt
JWT_ACCESS_TOKEN_EXPIRES=86400

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
HOST=0.0.0.0
PORT=5000

# Puente NFC + ESP32 (nfc-service). No cambiar salvo que el puente use otro puerto.
ESP32_BRIDGE_URL=http://localhost:5001
